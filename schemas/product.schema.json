{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4sup.invalid/schemas/product.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productId"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "productId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9]|[.-][a-z0-9])*$", "maxLength": 128 },
    "displayName": { "type": "string" },
    "icon": { "type": "string", "format": "uri" }
  }
}
