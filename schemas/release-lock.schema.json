{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4sup.invalid/schemas/release-lock.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "productId", "releaseId", "sequence", "state", "createdAt", "axes", "requirements", "packages", "coverageDigest"],
  "properties": {
    "schemaVersion": { "const": 1 }, "productId": { "$ref": "#/$defs/id" }, "releaseId": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 }, "state": { "enum": ["draft", "published", "yanked"] },
    "createdAt": { "$ref": "#/$defs/time" }, "minimumInstalledRelease": { "type": "integer", "minimum": 0 },
    "coverageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "axes": { "type": "array", "items": { "$ref": "#/$defs/axis" } },
    "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "packages": { "type": "array", "items": { "$ref": "#/$defs/pin" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9]|[.-][a-z0-9])*$", "maxLength": 128 },
    "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "axis": {
      "type": "object", "additionalProperties": false, "required": ["name", "rank", "values", "cardinality", "required"],
      "properties": {
        "name": { "$ref": "#/$defs/id" }, "rank": { "type": "integer" }, "required": { "type": "boolean" },
        "default": { "$ref": "#/$defs/id" }, "cardinality": { "enum": ["one", "many"] },
        "values": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "$ref": "#/$defs/id" }, "display": { "type": "string" } } } },
        "retired": { "type": "object", "additionalProperties": { "$ref": "#/$defs/id" } }, "displayName": { "type": "string" }
      }
    },
    "predicate": { "type": "object", "additionalProperties": false, "required": ["constraints"], "properties": { "constraints": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/id" } } } } },
    "requirement": {
      "type": "object", "additionalProperties": false, "required": ["package", "when", "overrides", "optional"],
      "properties": { "package": { "$ref": "#/$defs/id" }, "when": { "$ref": "#/$defs/predicate" }, "rankAs": { "$ref": "#/$defs/id" }, "layerOverride": { "type": "integer" }, "overrides": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "optional": { "type": "boolean" } }
    },
    "dependency": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "$ref": "#/$defs/id" }, "minSequence": { "type": "integer" }, "maxSequence": { "type": "integer" } } },
    "pin": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "sequence", "manifestPath", "manifestDigest", "fileCount", "installSize", "downloadSize", "requires", "overrides", "conflicts"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/id" }, "sequence": { "type": "integer", "minimum": 0 }, "manifestPath": { "type": "string" }, "manifestDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "fileCount": { "type": "integer", "minimum": 0 }, "installSize": { "type": "integer", "minimum": 0 }, "downloadSize": { "type": "integer", "minimum": 0 }, "requires": { "type": "array", "items": { "$ref": "#/$defs/dependency" } }, "overrides": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "conflicts": { "type": "array", "items": { "$ref": "#/$defs/id" } } }
    }
  }
}
