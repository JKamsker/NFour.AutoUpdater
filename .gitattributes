# Default: normalise text in the repository, check out with LF.
* text=auto eol=lf

# Byte-exact trees. These files are addressed by their own SHA-256, or are compared
# byte-for-byte against generated output, so any end-of-line translation on checkout changes
# their identity. On a machine with core.autocrlf=true and no rule here, every golden blob
# gains a byte per line and fails the digest that names it — which is how this surfaced.
tests/vectors/** -text
schemas/fixtures/** -text
*.schema.json -text

# Fixture and golden JSON documents are digested as-is.
tests/fixtures/** -text

# Shell scripts must keep LF regardless of platform.
*.sh text eol=lf
